{
  "name": "shreyas-portfolio",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "dev": "npm run dev --workspace=@portfolio/web",
